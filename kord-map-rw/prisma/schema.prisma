generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Marker {
  id          String   @id @default(cuid())
  title       String
  description String?
  lat         Float
  lng         Float
  floorId     String
  type        String
  imageUrl    String?  
  submitter   String?  
  approved    Boolean  @default(false)
  originalId  String?  
  isDeletion  Boolean  @default(false) // 🚀 NEW: Flags if this is a deletion request
  mapName     String   @default("Customs") 
  createdAt   DateTime @default(now())
}
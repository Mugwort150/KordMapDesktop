generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Marker {
  id             String   @id @default(cuid())
  title          String
  description    String?
  lat            Float
  lng            Float
  floorId        String
  type           String
  imageUrl       String?  
  submitter      String?  
  lastEditor     String?  // 🚀 NEW: Tracks who made the edit
  approved       Boolean  @default(false)
  originalId     String?  
  isDeletion     Boolean  @default(false)
  deletionReason String?  
  mapName        String   @default("Customs") 
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt // 🚀 NEW: Auto-updates on edit
}